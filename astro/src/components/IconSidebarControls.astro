---
import CodeCopy from "./CodeCopy.astro";
import FigmaLogo from "./FigmaLogo.astro";
---

<div
  class="icon-sidebar-controls d-flex flex-column align-items-stretch gap-4"
  data-pagefind-ignore
>
  <CodeCopy
    code="npm i bootstrap-icons"
    iconSize={12}
    variant="adorn"
  />
  <nav
    class="d-flex flex-row flex-wrap align-items-center justify-content-center gap-6"
    aria-label="Bootstrap Icons resources"
  >
    <a
      class="d-flex align-items-center gap-2 theme-secondary underline-secondary underline-30"
      href="https://github.com/twbs/icons/blob/main/README.md"
      target="_blank"
      rel="noopener"
    >
      <svg class="bi" width="1em" height="1em" aria-hidden="true">
        <use href="/bootstrap-icons.svg#github"></use>
      </svg>
      Documentation
    </a>
    <a
      class="d-flex align-items-center gap-2 theme-secondary underline-secondary underline-30"
      href="https://www.figma.com/community/file/1042482994486402696/Bootstrap-Icons"
      target="_blank"
      rel="noopener"
    >
      <FigmaLogo width="0.667em" height="1em" />
      Open in Figma
    </a>
  </nav>
</div>
