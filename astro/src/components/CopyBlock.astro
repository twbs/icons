---
interface Props {
  label: string
  code: string
  language?: string
}

const { label, code, language = 'html' } = Astro.props
---

<div class="bg-1 border rounded-5 overflow-hidden" data-copy-block>
  <div
    class="d-flex align-items-center justify-content-between px-4 py-2 fs-sm fg-2 border-bottom"
  >
    <span>{label}</span>
    <button
      class="btn-text theme-secondary btn-sm"
      type="button"
      data-copy-button
      aria-label={`Copy ${label}`}
    >
      <svg class="bi" aria-hidden="true"><use href="#copy"></use></svg>
      <span data-copy-label>Copy</span>
    </button>
  </div>
  <pre
    class="copy-code p-4 mb-0 overflow-auto fs-sm"
    tabindex="0"><code class={`language-${language}`} data-copy-source>{code}</code></pre>
  <p class="visually-hidden" aria-live="polite" data-copy-status></p>
</div>
