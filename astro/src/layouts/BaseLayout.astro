---
import SharedBaseLayout from "@twbs/docs-ui/components/BaseLayout";
import Head from "@twbs/docs-ui/components/Head";
import Header from "@twbs/docs-ui/components/Header";
import Footer from "@twbs/docs-ui/components/Footer";
import type { FooterColumn, NavigationConfig } from "@twbs/docs-ui";
import "../styles.scss";

interface Props {
  title: string;
  description?: string;
  canonical?: URL | string | false;
  robots?: string;
}

const {
  title,
  description = "Free, high quality, open source icon library.",
  canonical = Astro.url,
  robots,
} = Astro.props;
const pageTitle =
  title === "Bootstrap Icons" ? title : `${title} · Bootstrap Icons`;
const pathname = Astro.url.pathname;
const activeSection =
  pathname === "/" || pathname.startsWith("/icons/") ? "icons" : "icons";
const navigation: NavigationConfig = {
  activeSection,
  brandHref: "https://getbootstrap.com/",
  homeHref: "https://getbootstrap.com/",
  docsHref: "https://getbootstrap.com/docs/6.0/getting-started/introduction/",
  examplesHref: "https://getbootstrap.com/docs/6.0/examples/",
  iconsHref: "/",
  blogHref: "https://blog.getbootstrap.com/",
  githubHref: "https://github.com/twbs",
  openCollectiveHref: "https://opencollective.com/bootstrap",
  xHref: "https://x.com/getbootstrap",
  currentVersion: "6.0",
  currentVersionHref: "https://getbootstrap.com/docs/6.0/",
  previousVersions: [
    {
      label: "v5.3.x",
      href: "https://getbootstrap.com/docs/5.3/",
      note: "Latest",
    },
    { label: "v4.6.x", href: "https://getbootstrap.com/docs/4.6/" },
    { label: "v3.4.1", href: "https://getbootstrap.com/docs/3.4/" },
    { label: "v2.3.2", href: "https://getbootstrap.com/2.3.2/" },
  ],
  allVersionsHref: "https://getbootstrap.com/docs/versions/",
  searchPlaceholder: "Search icons…",
};
const columns: FooterColumn[] = [
  {
    title: "Project",
    links: [
      { label: "All icons", href: "/" },
      { label: "Documentation", href: "/docs/" },
      { label: "Usage", href: "/usage/" },
      { label: "Icon sprite", href: "/sprite/" },
      { label: "Icon font", href: "/font/" },
      {
        label: "GitHub",
        href: "https://github.com/twbs/icons",
        external: true,
      },
    ],
  },
  {
    title: "Bootstrap",
    links: [
      { label: "Bootstrap", href: "https://getbootstrap.com/", external: true },
      { label: "Blog", href: "https://blog.getbootstrap.com/", external: true },
    ],
  },
];
const socialImage = new URL(
  "/assets/img/bootstrap-icons-social.png",
  Astro.site,
);
const analyticsSiteId = import.meta.env.PUBLIC_FATHOM_SITE_ID;
---

<SharedBaseLayout bodyAttrs={{ id: "icons-body" }}>
  <Head
    slot="head"
    title={pageTitle}
    description={description}
    canonical={canonical || undefined}
    robots={robots}
  >
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link
      rel="apple-touch-icon"
      href="/assets/img/favicons/apple-touch-icon.png"
      sizes="180x180"
    />
    <link
      rel="icon"
      href="/assets/img/favicons/favicon-32x32.png"
      sizes="32x32"
      type="image/png"
    />
    <link
      rel="icon"
      href="/assets/img/favicons/favicon-16x16.png"
      sizes="16x16"
      type="image/png"
    />
    <link rel="manifest" href="/assets/img/favicons/manifest.json" />
    <link
      rel="mask-icon"
      href="/assets/img/favicons/safari-pinned-tab.svg"
      color="#712cf9"
    />
    <link rel="icon" href="/assets/img/favicons/favicon.ico" />
    <meta name="theme-color" content="#712cf9" />
    {
      analyticsSiteId && (
        <script
          is:inline
          defer
          src="https://cdn.usefathom.com/script.js"
          data-site={analyticsSiteId}
        />
      )
    }
  </Head>

  <Header slot="header" config={navigation} />

  <main slot="main" id="content">
    <slot />
  </main>

  <Footer slot="footer" brand="Bootstrap Icons" columns={columns}>
    <p>Official open source SVG icon library for Bootstrap.</p>
  </Footer>

</SharedBaseLayout>
