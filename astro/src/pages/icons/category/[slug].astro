---
import CategoryNav from "../../../components/CategoryNav.astro";
import IconCatalog from "../../../components/IconCatalog.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import {
  getCategories,
  getIcons,
  getPageItems,
  type IconCategory,
} from "../../../lib/icons";

export function getStaticPaths() {
  const icons = getIcons();
  const categories = getCategories(icons);

  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category, categories, totalCount: icons.length },
  }));
}

interface Props {
  category: IconCategory;
  categories: IconCategory[];
  totalCount: number;
}

const { category, categories, totalCount } = Astro.props;
const initialIcons = getPageItems(category.icons, 1);
const description = `Browse ${category.count.toLocaleString()} ${category.name} icons from Bootstrap Icons. Search, preview, and download SVGs or use the icon font.`;
---

<BaseLayout title={`${category.name} icons`} description={description}>
  <div class="2xl:container bd-gutter py-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb gap-2 my-4 p-0">
        <li class="breadcrumb-item"><a href="/">Icons</a></li>
        <li class="breadcrumb-item active" aria-current="page">
          {category.name}
        </li>
      </ol>
    </nav>

    <header class="xl:col-9 py-5 mb-7 border-bottom">
      <p class="mb-2 fs-sm fw-semibold text-uppercase fg-2">Icon category</p>
      <h1 class="fs-4xl fw-bold lh-1 mb-3">{category.name}</h1>
      <p class="fs-lg fw-light fg-2">{description}</p>
    </header>

    <div class="row lg:gx-7">
      <CategoryNav
        categories={categories}
        totalCount={totalCount}
        activeSlug={category.slug}
      />
      <div class="lg:col-9 xl:col-10">
        <IconCatalog
          icons={initialIcons}
          heading={`${category.name} icons`}
          totalCount={category.count}
          basePath={`/icons/category/${category.slug}/`}
          firstPagePath={`/icons/category/${category.slug}/`}
          categorySlug={category.slug}
          emptyMessage={`No ${category.name} icons match that search.`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
