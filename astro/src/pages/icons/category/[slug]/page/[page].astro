---
import BaseLayout from "../../../../../layouts/BaseLayout.astro";
import CategoryNav from "../../../../../components/CategoryNav.astro";
import IconCatalog from "../../../../../components/IconCatalog.astro";
import {
  getCategories,
  getIcons,
  getPageCount,
  getPageItems,
  type IconCategory,
} from "../../../../../lib/icons";

export function getStaticPaths() {
  const icons = getIcons();
  const categories = getCategories(icons);

  return categories.flatMap((category) => {
    const pageCount = getPageCount(category.count);
    return Array.from({ length: pageCount - 1 }, (_, index) => {
      const page = index + 2;
      return {
        params: { slug: category.slug, page: String(page) },
        props: {
          category,
          categories,
          icons: getPageItems(category.icons, page),
          page,
          pageCount,
          totalCount: icons.length,
        },
      };
    });
  });
}

interface Props {
  category: IconCategory;
  categories: IconCategory[];
  icons: ReturnType<typeof getIcons>;
  page: number;
  pageCount: number;
  totalCount: number;
}

const { category, categories, icons, page, pageCount, totalCount } =
  Astro.props;
const description = `Browse ${category.name} icons, page ${page.toLocaleString()} of ${pageCount.toLocaleString()}. Search all ${category.count.toLocaleString()} icons in this category.`;
---

<BaseLayout
  title={`${category.name} icons · Page ${page}`}
  description={description}
  catalogDrawer
>
  <div class="2xl:container bd-gutter py-4" data-pagefind-ignore>
    <div class="icon-catalog-layout">
      <CategoryNav {categories} {totalCount} activeSlug={category.slug} />
      <div class="icon-catalog-main">
        <IconCatalog
          {icons}
          heading={category.name}
          headingHref="/#icons"
          totalCount={category.count}
          {page}
          basePath={`/icons/category/${category.slug}/`}
          firstPagePath={`/icons/category/${category.slug}/`}
          categorySlug={category.slug}
          emptyMessage={`No ${category.name} icons match that search.`}
        />
      </div>
    </div>
  </div>
</BaseLayout>
