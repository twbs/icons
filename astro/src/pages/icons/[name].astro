---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CopyBlock from "../../components/CopyBlock.astro";
import { getIcons, type IconMeta } from "../../lib/icons";

export function getStaticPaths() {
  return getIcons().map((icon) => ({
    params: { name: icon.name },
    props: { icon },
  }));
}

interface Props {
  icon: IconMeta;
}

const { icon } = Astro.props;
const hex = icon.codepoint?.toString(16).toUpperCase();
const fontHtml = `<i class="bi bi-${icon.name}" aria-hidden="true"></i>`;
const css = `.icon-${icon.name} {
  display: inline-block;
  width: 1em;
  height: 1em;
  background-color: currentColor;
  mask: url("/assets/icons/${icon.name}.svg") center / contain no-repeat;
}`;
---

<BaseLayout
  title={icon.title}
  description={`${icon.title} icon from Bootstrap Icons.`}
>
  <nav aria-label="breadcrumb">
    <ol class="breadcrumb detail-breadcrumb">
      <li class="breadcrumb-item"><a href="/">Icons</a></li>
      <li class="breadcrumb-item active" aria-current="page">{icon.title}</li>
    </ol>
  </nav>
  <header class="detail-header">
    <div>
      <p class="eyebrow">Bootstrap icon</p>
      <h1>{icon.title}</h1>
      <p class="detail-filename">{icon.name}.svg</p>
    </div>
    <a
      class="btn-solid theme-accent"
      href={`/assets/icons/${icon.name}.svg`}
      download
    >
      Download SVG
    </a>
  </header>

  <div class="detail-layout">
    <div class="detail-main">
      <div
        class="icon-preview"
        role="img"
        aria-label={`${icon.title} large preview`}
        set:html={icon.svg}
      />

      <section class="detail-section" aria-labelledby="examples-heading">
        <h2 id="examples-heading">Examples</h2>
        <div class="icon-examples">
          <p class="example-heading">
            <span set:html={icon.decorativeSvg} /> Heading
          </p>
          <p>Inline text <span set:html={icon.decorativeSvg} /></p>
          <a href="/usage/"
            >Example link <span set:html={icon.decorativeSvg} /></a
          >
          <div>
            <button class="btn-solid theme-accent" type="button">
              <span set:html={icon.decorativeSvg} /> Button
            </button>
            <button
              class="btn-outline theme-secondary"
              type="button"
              aria-label={`${icon.title} example`}
            >
              <span set:html={icon.decorativeSvg} />
            </button>
          </div>
        </div>
      </section>

      <section class="detail-section copy-stack" aria-labelledby="code-heading">
        <h2 id="code-heading">Use this icon</h2>
        <CopyBlock label="SVG" code={icon.svg} />
        <CopyBlock label="Icon font HTML" code={fontHtml} />
        <CopyBlock label="CSS mask" code={css} language="css" />
      </section>
    </div>

    <aside class="detail-aside" aria-label="Icon metadata">
      {
        (icon.tags.length > 0 || icon.categories.length > 0) && (
          <section>
            <h2>Metadata</h2>
            {icon.categories.length > 0 && (
              <>
                <h3>Categories</h3>
                <div class="tag-list">
                  {icon.categories.map((category) => (
                    <a href={`/?q=${encodeURIComponent(category)}`}>
                      {category}
                    </a>
                  ))}
                </div>
              </>
            )}
            {icon.tags.length > 0 && (
              <>
                <h3>Tags</h3>
                <div class="tag-list">
                  {icon.tags.map((tag) => (
                    <a href={`/?q=${encodeURIComponent(tag)}`}>{tag}</a>
                  ))}
                </div>
              </>
            )}
          </section>
        )
      }
      {
        hex && (
          <section>
            <h2>Code point</h2>
            <dl class="codepoints">
              <div>
                <>
                  <dt>Unicode</dt>
                  <dd>
                    <code>U+{hex}</code>
                  </dd>
                </>
              </div>
              <div>
                <>
                  <dt>CSS</dt>
                  <dd>
                    <code>\{hex}</code>
                  </dd>
                </>
              </div>
              <div>
                <>
                  <dt>JavaScript</dt>
                  <dd>
                    <code>\u{hex}</code>
                  </dd>
                </>
              </div>
              <div>
                <>
                  <dt>HTML</dt>
                  <dd>
                    <code>&amp;#x{hex};</code>
                  </dd>
                </>
              </div>
            </dl>
          </section>
        )
      }
      <section>
        <h2>Related guides</h2>
        <ul>
          <li><a href="/usage/">Install and usage</a></li>
          <li><a href="/sprite/">SVG sprite</a></li>
          <li><a href="/">Back to all icons</a></li>
        </ul>
      </section>
    </aside>
  </div>
</BaseLayout>
