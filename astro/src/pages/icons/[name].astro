---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CopyBlock from "../../components/CopyBlock.astro";
import Redirect from "../../components/Redirect.astro";
import { getIcons, type IconMeta } from "../../lib/icons";

export function getStaticPaths() {
  return getIcons().flatMap((icon) => [
    {
      params: { name: icon.name },
      props: { icon },
    },
    ...icon.aliases
      .filter((alias) => /^\/icons\/[^/]+\/$/.test(alias))
      .map((alias) => ({
        params: { name: alias.split("/")[2] },
        props: { icon, redirectTo: `/icons/${icon.name}/` },
      })),
  ]);
}

interface Props {
  icon: IconMeta;
  redirectTo?: string;
}

const { icon, redirectTo } = Astro.props;
const hex = icon.codepoint?.toString(16).toUpperCase();
const fontHtml = `<i class="bi bi-${icon.name}" aria-hidden="true"></i>`;
const css = `.icon-${icon.name} {
  display: inline-block;
  width: 1em;
  height: 1em;
  background-color: currentColor;
  mask: url("/assets/icons/${icon.name}.svg") center / contain no-repeat;
}`;
---

{
  redirectTo ? (
    <Redirect destination={redirectTo} />
  ) : (
    <BaseLayout
      title={icon.title}
      description={`${icon.title} icon from Bootstrap Icons.`}
    >
  <div class="2xl:container bd-gutter py-4">
  <nav aria-label="breadcrumb">
      <ol class="breadcrumb gap-2 my-4 p-0">
      <li class="breadcrumb-item"><a href="/">Icons</a></li>
      <li class="breadcrumb-item active" aria-current="page">{icon.title}</li>
    </ol>
  </nav>
  <header
    class="d-flex flex-column md:flex-row gap-4 align-items-start md:align-items-end justify-content-between pb-5"
  >
    <div>
      <p class="mb-2 fs-sm fw-semibold text-uppercase fg-2">Bootstrap icon</p>
      <h1 class="fs-4xl fw-bold lh-1 mb-2">{icon.title}</h1>
      <p class="mb-0 fg-2 font-monospace">{icon.name}.svg</p>
    </div>
    <a
      class="btn-solid theme-accent"
      href={`/assets/icons/${icon.name}.svg`}
      download
    >
      Download SVG
    </a>
  </header>

  <div class="row lg:gx-5">
    <div class="lg:col-8 mb-5">
      <div
        class="icon-demo d-flex align-items-center justify-content-center p-4 mb-5 bg-1 border rounded-5"
        role="img"
        aria-label={`${icon.title} large preview`}
        set:html={icon.svg}
      />

      <section class="pt-5" aria-labelledby="examples-heading">
        <h2 id="examples-heading">Examples</h2>
        <div class="p-4 border rounded-5">
          <p class="fs-2 fw-semibold">
            <span set:html={icon.decorativeSvg} /> Heading
          </p>
          <p>Inline text <span set:html={icon.decorativeSvg} /></p>
          <a href="/usage/"
            >Example link <span set:html={icon.decorativeSvg} /></a
          >
          <div class="d-flex flex-wrap gap-3 mt-4">
            <button class="btn-solid theme-accent" type="button">
              <span set:html={icon.decorativeSvg} /> Button
            </button>
            <button
              class="btn-outline theme-secondary"
              type="button"
              aria-label={`${icon.title} example`}
            >
              <span set:html={icon.decorativeSvg} />
            </button>
          </div>
        </div>
      </section>

      <section
        class="d-grid gap-4 pt-7"
        aria-labelledby="code-heading"
      >
        <h2 id="code-heading">Use this icon</h2>
        <CopyBlock label="SVG" code={icon.svg} />
        <CopyBlock label="Icon font HTML" code={fontHtml} />
        <CopyBlock label="CSS mask" code={css} language="css" />
      </section>
    </div>

    <aside class="lg:col-4" aria-label="Icon metadata">
      {
        (icon.tags.length > 0 || icon.categories.length > 0) && (
          <section class="pb-5 mb-5 border-bottom">
            <h2 class="fs-xl">Metadata</h2>
            {icon.categories.length > 0 && (
              <>
                <h3 class="mt-4 fs-sm text-uppercase fg-2">Categories</h3>
                <div class="d-flex flex-wrap gap-2">
                  {icon.categories.map((category) => (
                    <a
                      class="chip theme-secondary text-decoration-none"
                      href={`/?q=${encodeURIComponent(category)}`}
                    >
                      {category}
                    </a>
                  ))}
                </div>
              </>
            )}
            {icon.tags.length > 0 && (
              <>
                <h3 class="mt-4 fs-sm text-uppercase fg-2">Tags</h3>
                <div class="d-flex flex-wrap gap-2">
                  {icon.tags.map((tag) => (
                    <a
                      class="chip theme-secondary text-decoration-none"
                      href={`/?q=${encodeURIComponent(tag)}`}
                    >
                      {tag}
                    </a>
                  ))}
                </div>
              </>
            )}
          </section>
        )
      }
      {
        hex && (
          <section class="pb-5 mb-5 border-bottom">
            <h2 class="fs-xl">Code point</h2>
            <dl class="d-grid gap-2 mb-0">
              <div class="d-flex justify-content-between">
                <>
                  <dt>Unicode</dt>
                  <dd class="mb-0">
                    <code>U+{hex}</code>
                  </dd>
                </>
              </div>
              <div class="d-flex justify-content-between">
                <>
                  <dt>CSS</dt>
                  <dd class="mb-0">
                    <code>\{hex}</code>
                  </dd>
                </>
              </div>
              <div class="d-flex justify-content-between">
                <>
                  <dt>JavaScript</dt>
                  <dd class="mb-0">
                    <code>\u{hex}</code>
                  </dd>
                </>
              </div>
              <div class="d-flex justify-content-between">
                <>
                  <dt>HTML</dt>
                  <dd class="mb-0">
                    <code>&amp;#x{hex};</code>
                  </dd>
                </>
              </div>
            </dl>
          </section>
        )
      }
      <section>
        <h2 class="fs-xl">Related guides</h2>
        <ul>
          <li><a href="/usage/">Install and usage</a></li>
          <li><a href="/sprite/">SVG sprite</a></li>
          <li><a href="/">Back to all icons</a></li>
        </ul>
      </section>
    </aside>
  </div>
  </div>
    </BaseLayout>
  )
}
