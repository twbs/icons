---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import CategoryNav from "../../../components/CategoryNav.astro";
import IconCatalog from "../../../components/IconCatalog.astro";
import {
  getCategories,
  getIcons,
  getPageCount,
  getPageItems,
} from "../../../lib/icons";

export function getStaticPaths() {
  const icons = getIcons();
  const pageCount = getPageCount(icons.length);

  return Array.from({ length: pageCount - 1 }, (_, index) => {
    const page = index + 2;
    return {
      params: { page: String(page) },
      props: {
        page,
        pageCount,
        icons: getPageItems(icons, page),
        categories: getCategories(icons),
        totalCount: icons.length,
      },
    };
  });
}

interface Props {
  page: number;
  pageCount: number;
  icons: ReturnType<typeof getIcons>;
  categories: ReturnType<typeof getCategories>;
  totalCount: number;
}

const { page, pageCount, icons, categories, totalCount } = Astro.props;
const description = `Browse Bootstrap Icons page ${page.toLocaleString()} of ${pageCount.toLocaleString()}. Search all ${totalCount.toLocaleString()} icons by name, tag, or category.`;
---

<BaseLayout title={`Icons · Page ${page}`} description={description}>
  <div class="2xl:container bd-gutter py-4">
    <nav aria-label="breadcrumb">
      <ol class="breadcrumb gap-2 my-4 p-0">
        <li class="breadcrumb-item"><a href="/">Icons</a></li>
        <li class="breadcrumb-item active" aria-current="page">
          Page {page}
        </li>
      </ol>
    </nav>

    <header class="xl:col-9 py-5 mb-7 border-bottom">
      <p class="mb-2 fs-sm fw-semibold text-uppercase fg-2">Icon catalog</p>
      <h1 class="fs-4xl fw-bold lh-1 mb-3">All icons, page {page}</h1>
      <p class="fs-lg fw-light fg-2">{description}</p>
    </header>

    <div class="row lg:gx-6">
      <CategoryNav categories={categories} totalCount={totalCount} />
      <div class="lg:col-9">
        <IconCatalog
          {icons}
          heading="Icons"
          {totalCount}
          {page}
        />
      </div>
    </div>
  </div>
</BaseLayout>
