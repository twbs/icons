---
import TableOfContents, {
  type TocEntry,
} from "@twbs/docs-ui/components/TableOfContents";
import BaseLayout from "../layouts/BaseLayout.astro";
import CopyBlock from "../components/CopyBlock.astro";
import DocsNav from "../components/DocsNav.astro";
import FigmaLogo from "../components/FigmaLogo.astro";
import HeadingAnchor from "../components/HeadingAnchor.astro";
import { getPackageMeta } from "../lib/icons";

const { version } = getPackageMeta();
const toc: TocEntry[] = [
  {
    slug: "install",
    text: "Install",
    children: [
      { slug: "package-managers", text: "Package managers", children: [] },
      { slug: "cdn", text: "CDN", children: [] },
    ],
  },
  {
    slug: "svg",
    text: "Use SVGs",
    children: [
      { slug: "embedded-svg", text: "Embedded SVG", children: [] },
      { slug: "external-image", text: "External image", children: [] },
      { slug: "svg-sprite", text: "SVG sprite", children: [] },
    ],
  },
  {
    slug: "icon-font",
    text: "Icon font",
    children: [
      { slug: "font-css", text: "CSS", children: [] },
      { slug: "font-sass", text: "Sass", children: [] },
    ],
  },
  {
    slug: "styling",
    text: "Sizing and color",
    children: [],
  },
  {
    slug: "accessibility",
    text: "Accessibility",
    children: [],
  },
  {
    slug: "css",
    text: "Use in CSS",
    children: [],
  },
  {
    slug: "figma",
    text: "Figma",
    children: [],
  },
  {
    slug: "resources",
    text: "Releases and resources",
    children: [],
  },
];

const embeddedSvg = `<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" fill="currentColor" class="bi bi-heart-fill" viewBox="0 0 16 16" aria-hidden="true">
  <path d="M4 1c2 0 3 1.5 4 3 1-1.5 2-3 4-3 2.5 0 4 2 4 4.5 0 3-2.5 5.5-8 9.5C2.5 11 0 8.5 0 5.5 0 3 1.5 1 4 1"/>
</svg>`;
---

<BaseLayout
  title="Documentation"
  description="Install Bootstrap Icons and use SVGs, the SVG sprite, icon font, Sass, CSS, and the Figma library accessibly."
>
  <div class="2xl:container bd-gutter py-5">
    <details class="lg:d-none mb-5">
      <summary class="btn-outline theme-secondary">Browse documentation</summary>
      <div class="mt-3"><DocsNav /></div>
    </details>

    <div class="row lg:gx-6">
      <aside class="d-none lg:d-block lg:col-2">
        <div class="position-sticky top-0"><DocsNav /></div>
      </aside>

      <div class="lg:col-7">
        <header class="pb-6 mb-7 border-bottom">
          <p class="mb-2 fs-sm fw-semibold text-uppercase fg-2">
            Bootstrap Icons
          </p>
          <h1 class="fs-4xl fw-bold lh-1 mb-3">Documentation</h1>
          <p class="fs-lg fw-light fg-2 mb-0">
            Bootstrap Icons are SVGs that work in any project—with or without
            Bootstrap. Install the package, then choose embedded SVG, an
            external image or sprite, or the icon font.
          </p>
        </header>

        <details class="lg:d-none mb-7">
          <summary class="btn-outline theme-secondary">On this page</summary>
          <nav class="bd-toc mt-3" aria-label="Table of contents">
            <TableOfContents entries={toc} />
          </nav>
        </details>

        <div class="prose docs-article">
          <section class="mb-9">
            <HeadingAnchor id="install" text="Install">Install</HeadingAnchor>
            <p>
              The published package contains individual SVG files, the combined
              SVG sprite, icon fonts, CSS, and Sass. Release archives also
              include the license and readme.
            </p>

            <HeadingAnchor
              id="package-managers"
              level={3}
              text="Package managers"
            >
              Package managers
            </HeadingAnchor>
            <div class="row row-cols-1 md:row-cols-2 g-4 mb-5">
              <div class="col">
                <CopyBlock
                  label="npm"
                  code="npm install bootstrap-icons"
                  language="shell"
                />
              </div>
              <div class="col">
                <CopyBlock
                  label="Composer"
                  code="composer require twbs/bootstrap-icons"
                  language="shell"
                />
              </div>
            </div>
            <p>
              You can also <a href="https://github.com/twbs/icons/releases/latest/"
                >download the latest release archive</a
              >.
            </p>

            <HeadingAnchor id="cdn" level={3} text="CDN">CDN</HeadingAnchor>
            <p>
              For the icon font, include the versioned jsDelivr stylesheet in
              your document head or import it from your stylesheet.
            </p>
            <CopyBlock
              label="CDN link"
              code={`<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@${version}/font/bootstrap-icons.min.css">`}
            />
            <div class="mt-4">
              <CopyBlock
                label="CSS import"
                language="css"
                code={`@import url("https://cdn.jsdelivr.net/npm/bootstrap-icons@${version}/font/bootstrap-icons.min.css");`}
              />
            </div>
          </section>

          <section class="mb-9">
            <HeadingAnchor id="svg" text="Use SVGs">Use SVGs</HeadingAnchor>
            <p>
              SVG is the most direct format and gives you control over
              semantics, size, and color. A width and height of <code>1em</code>
              lets an embedded icon scale with surrounding text.
            </p>

            <HeadingAnchor id="embedded-svg" level={3} text="Embedded SVG">
              Embedded SVG
            </HeadingAnchor>
            <div class="d-flex align-items-center gap-4 p-5 my-4 fs-2 bg-1 border rounded-5">
              <svg
                class="bi"
                width="32"
                height="32"
                viewBox="0 0 16 16"
                fill="currentColor"
                aria-hidden="true"
              >
                <use href="/bootstrap-icons.svg#heart-fill"></use>
              </svg>
              <span>Inline markup inherits <code>currentColor</code>.</span>
            </div>
            <CopyBlock label="Embedded SVG" code={embeddedSvg} />

            <HeadingAnchor id="external-image" level={3} text="External image">
              External image
            </HeadingAnchor>
            <p>
              Copy an SVG into your project and reference it like any other
              image. Use useful alt text when the image conveys meaning and an
              empty <code>alt</code> when it is decorative.
            </p>
            <CopyBlock
              label="Image element"
              code='<img src="/icons/bootstrap.svg" alt="Bootstrap" width="32" height="32">'
            />

            <HeadingAnchor id="svg-sprite" level={3} text="SVG sprite">
              SVG sprite
            </HeadingAnchor>
            <p>
              The package includes <code>bootstrap-icons.svg</code>. Copy it to
              your own origin and use an icon filename as the fragment
              identifier. Cross-origin external sprites are restricted by some
              browsers, so serve the sprite with your application.
            </p>
            <CopyBlock
              label="External sprite"
              code={`<svg class="bi" width="32" height="32" fill="currentColor" aria-hidden="true">
  <use href="/bootstrap-icons.svg#toggles"></use>
</svg>`}
            />
            <p class="mt-4">
              See the <a href="/sprite/">complete sprite guide</a> for local and
              external examples.
            </p>
          </section>

          <section class="mb-9">
            <HeadingAnchor id="icon-font" text="Icon font">
              Icon font
            </HeadingAnchor>
            <p>
              Include the font stylesheet, then combine the base
              <code>bi</code> class with an icon class based on its filename.
              Font icons inherit text size and color.
            </p>

            <HeadingAnchor id="font-css" level={3} text="Icon font CSS">
              CSS
            </HeadingAnchor>
            <CopyBlock
              label="Icon font markup"
              code='<i class="bi bi-alarm" aria-hidden="true"></i>'
            />

            <HeadingAnchor id="font-sass" level={3} text="Icon font Sass">
              Sass
            </HeadingAnchor>
            <p>
              When your Sass compiler cannot resolve the package’s relative
              font URLs, set the font directory before importing the source.
              This is commonly needed with Vite and Parcel.
            </p>
            <CopyBlock
              label="Sass import"
              language="scss"
              code={`$bootstrap-icons-font-dir: "bootstrap-icons/font/fonts";
@import "bootstrap-icons/font/bootstrap-icons";`}
            />
            <p class="mt-4">
              See the <a href="/font/">icon font guide</a> for class examples
              and the generated font stylesheet.
            </p>
          </section>

          <section class="mb-9">
            <HeadingAnchor id="styling" text="Sizing and color">
              Sizing and color
            </HeadingAnchor>
            <p>
              Embedded SVGs and the icon font use <code>currentColor</code>.
              Set <code>color</code> directly or use Bootstrap text color
              utilities. Set <code>font-size</code> when the icon dimensions
              are <code>1em</code>.
            </p>
            <CopyBlock
              label="Sizing and color"
              language="css"
              code={`.feature-icon {
  color: cornflowerblue;
  font-size: 2rem;
}`}
            />
          </section>

          <section class="mb-9">
            <HeadingAnchor id="accessibility" text="Accessibility">
              Accessibility
            </HeadingAnchor>
            <p>
              Hide purely decorative icons from assistive technology with
              <code>aria-hidden="true"</code>. Meaningful standalone images
              need an appropriate text alternative. For icon-only controls,
              put the accessible name on the control—not on its decorative
              child icon.
            </p>
            <CopyBlock
              label="Accessible icon button"
              code={`<button type="button" aria-label="Mute">
  <svg class="bi" aria-hidden="true">
    <use href="/bootstrap-icons.svg#volume-mute-fill"></use>
  </svg>
</button>`}
            />
            <div class="p-4 mt-4 bg-1 border rounded-5">
              <strong>Prefer visible text when possible.</strong> A visible
              label or a <code>visually-hidden</code> label stays available to
              screen readers and supports users who may not recognize an icon.
            </div>
          </section>

          <section class="mb-9">
            <HeadingAnchor id="css" text="Use in CSS">Use in CSS</HeadingAnchor>
            <p>
              SVG data URLs work in CSS, but URL-sensitive characters must be
              escaped—for example, <code>#</code> becomes <code>%23</code>.
              Keep the <code>viewBox</code> when resizing with
              <code>background-size</code>, and include the SVG namespace.
            </p>
            <CopyBlock
              label="SVG background"
              language="css"
              code={`.icon-example {
  width: 1rem;
  height: 1rem;
  background-image: url("data:image/svg+xml,<svg viewBox='0 0 16 16' fill='%23333' xmlns='http://www.w3.org/2000/svg'>…</svg>");
  background-repeat: no-repeat;
  background-size: 1rem 1rem;
}`}
            />
          </section>

          <section class="mb-9">
            <HeadingAnchor id="figma" text="Figma">Figma</HeadingAnchor>
            <p>
              The official Bootstrap Icons community file makes the icon set
              available in Figma for design work.
            </p>
            <a
              class="btn-outline theme-secondary d-inline-flex align-items-center"
              href="https://www.figma.com/community/file/1042482994486402696/Bootstrap-Icons"
              target="_blank"
              rel="noopener"
            >
              <FigmaLogo class="me-2" />
              Open in Figma
            </a>
          </section>

          <section class="mb-9">
            <HeadingAnchor id="resources" text="Releases and resources">
              Releases and resources
            </HeadingAnchor>
            <ul>
              <li><a href="/">Browse and search every icon</a></li>
              <li><a href="/usage/">Detailed installation and usage guide</a></li>
              <li><a href="/sprite/">SVG sprite guide</a></li>
              <li><a href="/font/">Icon font guide</a></li>
              <li>
                <a href="https://github.com/twbs/icons/releases"
                  >Release notes and downloads</a
                >
              </li>
              <li>
                <a href="https://www.npmjs.com/package/bootstrap-icons"
                  >Package on npm</a
                >
              </li>
              <li><a href="https://github.com/twbs/icons">Source on GitHub</a></li>
            </ul>
          </section>
        </div>
      </div>

      <aside class="d-none lg:d-block lg:col-3">
        <nav
          class="bd-toc position-sticky top-0"
          aria-label="Table of contents"
          data-docs-toc
        >
          <p class="fw-semibold mb-2">On this page</p>
          <TableOfContents entries={toc} />
        </nav>
      </aside>
    </div>
  </div>

  <script>
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-docs-toc] a"),
  ];
  const linkById = new Map(
    links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]),
  );
  const headings = [...linkById.keys()]
    .map((id) => document.getElementById(id))
    .filter((heading): heading is HTMLElement => Boolean(heading));

  if ("IntersectionObserver" in window) {
    const visible = new Set<string>();
    const activate = () => {
      const id =
        headings.find((heading) => visible.has(heading.id))?.id ??
        headings
          .filter((heading) => heading.getBoundingClientRect().top < 140)
          .at(-1)?.id;
      for (const [headingId, link] of linkById) {
        link.classList.toggle("active", headingId === id);
        headingId === id
          ? link.setAttribute("aria-current", "location")
          : link.removeAttribute("aria-current");
      }
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.isIntersecting
            ? visible.add(entry.target.id)
            : visible.delete(entry.target.id);
        }
        activate();
      },
      { rootMargin: "-120px 0px -65% 0px" },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
  </script>
</BaseLayout>
