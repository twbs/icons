---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  title="Bootstrap Icons font"
  description="Use Bootstrap Icons through the bundled icon font."
>
  <article class="docs-page docs-page-compact">
    <header class="docs-hero">
      <p class="eyebrow">Icon font</p>
      <h1>Bootstrap Icons font</h1>
      <p class="lead">
        The font, CSS, Sass, SVGs, and sprite ship together in the Bootstrap
        Icons package.
      </p>
      <a class="btn btn-solid" href="/usage/#icon-font"
        >Read the icon font guide</a
      >
    </header>
  </article>
</BaseLayout>
