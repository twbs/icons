---
import BaseLayout from '../layouts/BaseLayout.astro'
import { getIcons, getPackageMeta } from '../lib/icons'

const icons = getIcons()
const { version } = getPackageMeta()
---

<BaseLayout title="Bootstrap Icons">
  <section class="hero py-5">
    <div class="hero-copy">
      <p class="eyebrow">Official Bootstrap icon library</p>
      <h1>Bootstrap Icons</h1>
      <p class="lead">
        Free, high quality, open source icons. Use all {
          icons.length.toLocaleString()
        } as SVGs, an SVG sprite, or icon fonts—with or without Bootstrap.
      </p>
      <div class="hero-actions">
        <code>npm i bootstrap-icons</code>
        <a class="btn btn-solid" href="/usage/">Read the usage guide</a>
        <a
          class="btn btn-outline"
          href="https://www.figma.com/community/file/1042482994486402696/Bootstrap-Icons"
          >Open in Figma</a
        >
      </div>
      <p class="hero-meta">
        Current release <a
          href={`https://github.com/twbs/icons/releases/tag/v${version}`}
          >v{version}</a
        >
        <span aria-hidden="true">·</span>
        <a href="/sprite/">SVG sprite</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/twbs/icons">GitHub</a>
      </p>
    </div>
    <img
      class="hero-art"
      src="/assets/img/icons-hero.png"
      srcset="/assets/img/icons-hero.png 1x, /assets/img/icons-hero@2x.png 2x"
      width="450"
      height="340"
      alt=""
    />
  </section>

  <section id="icons" class="catalog-section" aria-labelledby="catalog-heading">
    <div class="catalog-heading">
      <div>
        <h2 id="catalog-heading">Icon catalog</h2>
        <p class="catalog-count" aria-live="polite">
          <span data-result-count>{icons.length.toLocaleString()}</span> icons
        </p>
      </div>
      <form class="catalog-search" role="search" data-icon-search>
        <label for="icon-filter">Search icons</label>
        <div class="search-control">
          <svg class="bi" aria-hidden="true"><use href="#search"></use></svg>
          <input
            class="form-control"
            id="icon-filter"
            name="q"
            type="search"
            placeholder="Try “arrow” or “brand”…"
            autocomplete="off"
            spellcheck="false"
            data-icon-filter
          />
        </div>
      </form>
    </div>
    <ul class="icon-grid" data-icon-grid>
      {
        icons.map((icon) => (
          <li
            data-icon-name={`${icon.name} ${icon.title} ${icon.tags.join(' ')} ${icon.categories.join(' ')}`.toLowerCase()}
          >
            <a class="icon-card" href={`/icons/${icon.name}/`}>
              <span class="icon-card-preview" set:html={icon.decorativeSvg} />
              <span class="icon-card-name">{icon.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="catalog-empty" hidden data-empty-state>
      <svg class="bi" aria-hidden="true"><use href="#search"></use></svg>
      <h3>No icons found</h3>
      <p>Try a different name, tag, or category.</p>
      <button class="btn btn-outline" type="button" data-clear-filter
        >Clear search</button
      >
    </div>
  </section>

  <section class="home-guides" aria-labelledby="guides-heading">
    <div>
      <p class="eyebrow">Flexible by design</p>
      <h2 id="guides-heading">Use icons your way</h2>
      <p>
        Install from npm or Composer, download a release, or load the icon font
        from a CDN.
      </p>
    </div>
    <a class="guide-card" href="/usage/">
      <span>Install and usage</span>
      <strong>SVG, font, Sass, CSS, and accessibility guidance</strong>
    </a>
    <a class="guide-card" href="/sprite/">
      <span>SVG sprite</span>
      <strong>Reference every icon from one cacheable asset</strong>
    </a>
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-icon-search]')
    const input = document.querySelector<HTMLInputElement>('[data-icon-filter]')
    const cards = [
      ...document.querySelectorAll<HTMLElement>('[data-icon-name]')
    ]
    const count = document.querySelector<HTMLElement>('[data-result-count]')
    const empty = document.querySelector<HTMLElement>('[data-empty-state]')
    const clear = document.querySelector<HTMLButtonElement>(
      '[data-clear-filter]'
    )

    const filter = (value: string, updateUrl = true) => {
      const query = value.trim().toLowerCase()
      const terms = query.split(/\s+/).filter(Boolean)
      let visible = 0

      for (const card of cards) {
        const haystack = card.dataset.iconName ?? ''
        const matches = terms.every((term) => haystack.includes(term))
        card.hidden = !matches
        if (matches) visible += 1
      }

      if (count) count.textContent = visible.toLocaleString()
      if (empty) empty.hidden = visible !== 0

      if (updateUrl) {
        const url = new URL(window.location.href)
        query ? url.searchParams.set('q', query) : url.searchParams.delete('q')
        history.replaceState(null, '', url)
      }
    }

    form?.addEventListener('submit', (event) => event.preventDefault())
    input?.addEventListener('input', () => filter(input.value))
    clear?.addEventListener('click', () => {
      if (!input) return
      input.value = ''
      filter('')
      input.focus()
    })

    const initialQuery = new URLSearchParams(window.location.search).get('q')
    if (input && initialQuery) {
      input.value = initialQuery
      filter(initialQuery, false)
      document.querySelector('#icons')?.scrollIntoView()
    }
  </script>
</BaseLayout>
